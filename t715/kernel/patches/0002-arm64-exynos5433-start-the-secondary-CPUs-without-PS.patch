diff --git a/arch/arm64/kernel/smp_exynos5433.c b/arch/arm64/kernel/smp_exynos5433.c
new file mode 100644
index 000000000..19fce5018
--- /dev/null
+++ b/arch/arm64/kernel/smp_exynos5433.c
@@ -0,0 +1,490 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos 5433: secondary CPUs of a 64-bit kernel, without PSCI.
+ *
+ * The device tree selects this with enable-method = "samsung,exynos5433-el2".
+ * The PMU powers a core on and the monitor releases it, in AArch32, at the
+ * address in its boot register (sysram-ns + 0x1c).  A short path takes it
+ * from there to the kernel (smp_exynos5433_head.S):
+ *
+ *   AArch32 entry  ->  SMC 0x82000400  ->  AArch64 at EL2  ->  eret to EL1
+ *   ->  holding pen  ->  secondary_entry
+ *
+ * The PMU sequence is the one of the vendor's 32-bit kernel, as ported to
+ * the 32-bit kernel of this board (arch/arm/mach-exynos/platsmp.c of the
+ * release tree; "platsmp.c" below is that file, and its comments cite the
+ * vendor files).  That kernel runs all eight cores with it.
+ *
+ * No clock, no voltage and no power domain is touched here.
+ */
+
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/smp.h>
+#include <linux/types.h>
+#include <linux/soc/samsung/exynos-regs-pmu.h>
+
+#include <asm/barrier.h>
+#include <asm/cacheflush.h>
+#include <asm/cpu_ops.h>
+#include <asm/cputype.h>
+
+extern char exynos5433_smp_entry[];		/* AArch32: what the boot register gets */
+extern char exynos5433_smp_entry_el2[];	/* AArch64: what the monitor is given */
+
+/* Two clusters of four: "KFC" (Cortex-A53) at MPIDR Aff1 = 1, "EAGLE"
+ * (Cortex-A57) at Aff1 = 0 (platsmp.c:33-51)
+ */
+#define EXYNOS5433_NR_CLUSTERS		2
+#define EXYNOS5433_CORES_PER_CLUSTER	4
+#define EXYNOS5433_NR_CORES		(EXYNOS5433_NR_CLUSTERS * \
+					 EXYNOS5433_CORES_PER_CLUSTER)
+
+/* EXYNOS_CORE_PWR_EN: the pattern of a powered core (platsmp.c:53-54) */
+#define EXYNOS5433_CORE_PWR_EN		0xf
+/* DURATION0..3 sit at CORE_CONFIGURATION + 0x10..0x1c (platsmp.c:55-62) */
+#define EXYNOS5433_CORE_DURATION(n, i)	(EXYNOS_ARM_CORE_CONFIGURATION(n) + 0x10 + 4 * (i))
+#define EXYNOS5433_DUR_WAIT_RESET	(0xf << 20)
+#define EXYNOS5433_DUR_SCALL		(0xf << 4)
+#define EXYNOS5433_DUR_SCALL_VALUE	(0x1 << 4)
+#define EXYNOS5433_DUR_FEEDBACK_MASK	(0xff << 4)
+#define EXYNOS5433_DUR_FEEDBACK_VALUE	(0x11 << 4)
+#define EXYNOS5433_USE_SMPEN		BIT(28)		/* platsmp.c:63 */
+/* The "UP scheduler" (platsmp.c:64-67) */
+#define EXYNOS5433_UP_SCHEDULER		0x0120
+#define EXYNOS5433_ENABLE_EAGLE_CPU	BIT(0)
+#define EXYNOS5433_ENABLE_KFC_CPU	BIT(1)
+/* Cluster logic and sequencer, for the record (platsmp.c:68-74) */
+#define EXYNOS5433_EAGLE_NONCPU_CONFIGURATION	0x2400
+#define EXYNOS5433_KFC_NONCPU_CONFIGURATION	0x2420
+#define EXYNOS5433_EAGLE_CPUSEQ_CONFIGURATION	0x2480
+#define EXYNOS5433_KFC_CPUSEQ_CONFIGURATION	0x24a0
+#define EXYNOS5433_L2_CONFIGURATION(c)	(0x2600 + 0x20 * (c))
+/* The monitor's one boot register, for all cores (platsmp.c:79,
+ * arch/arm/mach-exynos/firmware.c:89), and the boot flags after it
+ * (platsmp.c:80)
+ */
+#define EXYNOS5433_BOOT_ADDR_OFFSET	0x1c
+#define EXYNOS5433_BOOT_FLAG_OFFSET	0x28
+/* One boot flag word per core, at that offset + 4 * PMU core index; the
+ * HOTPLUG flag of the vendor kernel (platsmp.c:75-80)
+ */
+#define EXYNOS5433_BOOT_FLAG_HOTPLUG	BIT(2)
+/* The release loop: as many tries of udelay(10) as make about the second
+ * the 32-bit kernel gives a core (platsmp.c:677-688)
+ */
+#define EXYNOS5433_RELEASE_TRIES	100000
+
+/*
+ * The pen of smp_exynos5433_head.S.  Cores read it with their MMU off, so
+ * it sits in the section the kernel keeps apart for that, and whoever
+ * writes it cleans it (write_pen_release()).
+ */
+u64 exynos5433_smp_pen_release __section(".mmuoff.data.read") = INVALID_HWID;
+
+enum exynos5433_smp_state {
+	EXYNOS5433_SMP_NEW,		/* nothing prepared yet */
+	EXYNOS5433_SMP_READY,
+	/* Nothing can be started: the board lacks what it takes, or an
+	 * earlier core failed to start.
+	 */
+	EXYNOS5433_SMP_FAILED,
+};
+
+static void __iomem *exynos5433_pmu;
+static void __iomem *exynos5433_sysram_ns;
+static enum exynos5433_smp_state exynos5433_smp_state;
+/* set by the CPU that comes up (.cpu_postboot), read by the one starting it */
+static bool exynos5433_arrived;
+/* one core at a time, from its power-up to its arrival in the kernel */
+static DEFINE_MUTEX(exynos5433_boot_lock);
+
+static u32 exynos5433_pmu_read(unsigned int offset)
+{
+	return readl(exynos5433_pmu + offset);
+}
+
+static void exynos5433_pmu_write(u32 val, unsigned int offset)
+{
+	writel(val, exynos5433_pmu + offset);
+}
+
+/* stock exynos5433_cpu_state(), pmu-exynos5433.c:146-158 */
+static bool exynos5433_core_powered(unsigned int idx)
+{
+	return (exynos5433_pmu_read(EXYNOS_ARM_CORE_STATUS(idx)) &
+		EXYNOS5433_CORE_PWR_EN) == EXYNOS5433_CORE_PWR_EN;
+}
+
+/* PMU core index: core + 4 * cluster (platsmp.c:89-93) */
+static unsigned int exynos5433_pmu_core(u64 mpidr)
+{
+	return MPIDR_AFFINITY_LEVEL(mpidr, 0) +
+	       EXYNOS5433_CORES_PER_CLUSTER * MPIDR_AFFINITY_LEVEL(mpidr, 1);
+}
+
+static void exynos5433_show_core(const char *when, unsigned int idx)
+{
+	pr_info("EXYNOS5433: %s: PMU core %u (MPIDR 0x%03x): CONF 0x%08x STATUS 0x%08x OPTION 0x%08x DUR0-3 0x%08x 0x%08x 0x%08x 0x%08x\n",
+		when, idx,
+		((idx / EXYNOS5433_CORES_PER_CLUSTER) << MPIDR_LEVEL_BITS_SHIFT) |
+		(idx % EXYNOS5433_CORES_PER_CLUSTER),
+		exynos5433_pmu_read(EXYNOS_ARM_CORE_CONFIGURATION(idx)),
+		exynos5433_pmu_read(EXYNOS_ARM_CORE_STATUS(idx)),
+		exynos5433_pmu_read(EXYNOS_ARM_CORE_OPTION(idx)),
+		exynos5433_pmu_read(EXYNOS5433_CORE_DURATION(idx, 0)),
+		exynos5433_pmu_read(EXYNOS5433_CORE_DURATION(idx, 1)),
+		exynos5433_pmu_read(EXYNOS5433_CORE_DURATION(idx, 2)),
+		exynos5433_pmu_read(EXYNOS5433_CORE_DURATION(idx, 3)));
+}
+
+/* PMU and monitor state as the firmware left it: the CPU part of the
+ * 32-bit kernel's dump (platsmp.c:412-453).  Read only.
+ */
+static void exynos5433_show_cpu_pmu(const char *when)
+{
+	void __iomem *flags = exynos5433_sysram_ns + EXYNOS5433_BOOT_FLAG_OFFSET;
+	unsigned int i, c;
+
+	for (i = 0; i < EXYNOS5433_NR_CORES; i++)
+		exynos5433_show_core(when, i);
+
+	for (c = 0; c < EXYNOS5433_NR_CLUSTERS; c++) {
+		u32 noncpu = c ? EXYNOS5433_KFC_NONCPU_CONFIGURATION :
+				 EXYNOS5433_EAGLE_NONCPU_CONFIGURATION;
+		u32 cpuseq = c ? EXYNOS5433_KFC_CPUSEQ_CONFIGURATION :
+				EXYNOS5433_EAGLE_CPUSEQ_CONFIGURATION;
+
+		pr_info("EXYNOS5433: %s: %s NONCPU 0x%08x/0x%08x/0x%08x L2 0x%08x/0x%08x/0x%08x CPUSEQ 0x%08x/0x%08x/0x%08x (CONF/STATUS/OPTION)\n",
+			when, c ? "KFC" : "EAGLE",
+			exynos5433_pmu_read(noncpu), exynos5433_pmu_read(noncpu + 0x4),
+			exynos5433_pmu_read(noncpu + 0x8),
+			exynos5433_pmu_read(EXYNOS5433_L2_CONFIGURATION(c)),
+			exynos5433_pmu_read(EXYNOS5433_L2_CONFIGURATION(c) + 0x4),
+			exynos5433_pmu_read(EXYNOS5433_L2_CONFIGURATION(c) + 0x8),
+			exynos5433_pmu_read(cpuseq), exynos5433_pmu_read(cpuseq + 0x4),
+			exynos5433_pmu_read(cpuseq + 0x8));
+	}
+
+	pr_info("EXYNOS5433: %s: UP_SCHEDULER 0x%08x\n", when,
+		exynos5433_pmu_read(EXYNOS5433_UP_SCHEDULER));
+
+	pr_info("EXYNOS5433: %s: monitor boot addr 0x%08x, boot flags %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		when, readl(exynos5433_sysram_ns + EXYNOS5433_BOOT_ADDR_OFFSET),
+		readl(flags + 0x00), readl(flags + 0x04),
+		readl(flags + 0x08), readl(flags + 0x0c),
+		readl(flags + 0x10), readl(flags + 0x14),
+		readl(flags + 0x18), readl(flags + 0x1c));
+}
+
+/*
+ * What the vendor kernel does to the PMU before any secondary is started
+ * (exynos5433_pmu_init(), pmu-exynos5433.c:457-545), as far as CPU and
+ * cluster power sequencing goes: the 32-bit kernel's
+ * exynos5433_pmu_cpu_init() (platsmp.c:455-500), in the same order.  On
+ * this board, that kernel writes these registers with these bits at every
+ * boot.
+ */
+static void exynos5433_pmu_cpu_init(void)
+{
+	unsigned int i;
+	u32 val;
+
+	for (i = 0; i < EXYNOS5433_NR_CLUSTERS; i++) {
+		u32 opt = (i ? EXYNOS5433_KFC_NONCPU_CONFIGURATION :
+			       EXYNOS5433_EAGLE_NONCPU_CONFIGURATION) + 0x8;
+
+		val = exynos5433_pmu_read(opt);
+		val &= ~EXYNOS5_USE_SC_COUNTER;
+		val |= EXYNOS5_USE_SC_FEEDBACK;
+		exynos5433_pmu_write(val, opt);
+	}
+
+	for (i = 0; i < EXYNOS5433_NR_CORES; i++) {
+		val = exynos5433_pmu_read(EXYNOS_ARM_CORE_OPTION(i));
+		val |= EXYNOS5_USE_SC_COUNTER | EXYNOS5_USE_SC_FEEDBACK |
+		       EXYNOS5433_USE_SMPEN;
+		exynos5433_pmu_write(val, EXYNOS_ARM_CORE_OPTION(i));
+	}
+
+	for (i = 0; i < EXYNOS5433_NR_CORES; i++) {
+		val = exynos5433_pmu_read(EXYNOS5433_CORE_DURATION(i, 0));
+		val |= EXYNOS5433_DUR_WAIT_RESET;
+		val &= ~EXYNOS5433_DUR_SCALL;
+		val |= EXYNOS5433_DUR_SCALL_VALUE;
+		exynos5433_pmu_write(val, EXYNOS5433_CORE_DURATION(i, 0));
+	}
+
+	val = exynos5433_pmu_read(EXYNOS5433_UP_SCHEDULER);
+	val |= EXYNOS5433_ENABLE_EAGLE_CPU | EXYNOS5433_ENABLE_KFC_CPU;
+	exynos5433_pmu_write(val, EXYNOS5433_UP_SCHEDULER);
+}
+
+/*
+ * Make the pen reach the memory: a core waiting in it takes part in no
+ * coherency and reads it there (smp_exynos5433_head.S).
+ */
+static void write_pen_release(u64 val)
+{
+	exynos5433_smp_pen_release = val;
+	dcache_clean_inval_poc((unsigned long)&exynos5433_smp_pen_release,
+			       (unsigned long)&exynos5433_smp_pen_release +
+			       sizeof(exynos5433_smp_pen_release));
+}
+
+/*
+ * stock exynos5433_cpu_up(), pmu-exynos5433.c:88-128, with the block the
+ * vendor defconfig enables (platsmp.c:573-603)
+ */
+static void exynos5433_core_power_up(unsigned int idx)
+{
+	unsigned int i;
+	u32 val;
+
+	val = exynos5433_pmu_read(EXYNOS_ARM_CORE_OPTION(idx));
+	val &= ~EXYNOS5_USE_SC_FEEDBACK;
+	exynos5433_pmu_write(val, EXYNOS_ARM_CORE_OPTION(idx));
+
+	for (i = 0; i < 4; i++) {
+		val = exynos5433_pmu_read(EXYNOS5433_CORE_DURATION(idx, i));
+		val &= ~EXYNOS5433_DUR_FEEDBACK_MASK;
+		val |= EXYNOS5433_DUR_FEEDBACK_VALUE;
+		exynos5433_pmu_write(val, EXYNOS5433_CORE_DURATION(idx, i));
+	}
+
+	/* the pen and the entry point reach memory before the core runs */
+	wmb();
+
+	val = exynos5433_pmu_read(EXYNOS_ARM_CORE_CONFIGURATION(idx));
+	val |= EXYNOS5433_CORE_PWR_EN;
+	exynos5433_pmu_write(val, EXYNOS_ARM_CORE_CONFIGURATION(idx));
+}
+
+/*
+ * exynos_clear_boot_flag() of the 32-bit kernel (arch/arm/mach-exynos/
+ * firmware.c:265-272): only the bit asked for goes.
+ */
+static void exynos5433_clear_boot_flag(unsigned int idx, u32 flag)
+{
+	void __iomem *word = exynos5433_sysram_ns +
+			     EXYNOS5433_BOOT_FLAG_OFFSET + 4 * idx;
+
+	writel(readl(word) & ~flag, word);
+}
+
+/* The cores this SoC has: Aff0 below 4, Aff1 below 2, nothing above (the
+ * check the 32-bit kernel makes in exynos5433_boot_secondary(),
+ * platsmp.c:625-630).  A CPU that fails it is left out of the kernel.
+ */
+static int exynos5433_cpu_init(unsigned int cpu)
+{
+	u64 mpidr = cpu_logical_map(cpu);
+
+	if (MPIDR_AFFINITY_LEVEL(mpidr, 0) >= EXYNOS5433_CORES_PER_CLUSTER ||
+	    MPIDR_AFFINITY_LEVEL(mpidr, 1) >= EXYNOS5433_NR_CLUSTERS ||
+	    mpidr >> (MPIDR_LEVEL_BITS_SHIFT * 2)) {
+		pr_err("EXYNOS5433: CPU%u: unexpected MPIDR 0x%0llx\n", cpu, mpidr);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/*
+ * What the 32-bit kernel does in exynos5433_smp_prepare_cpus()
+ * (platsmp.c:502-545): map, record what the firmware left, put the entry
+ * point in place, prepare the PMU.  smp_prepare_cpus() calls this for
+ * every secondary, and not at all with "nosmp": nothing here runs then.
+ */
+static int exynos5433_cpu_prepare(unsigned int cpu)
+{
+	struct device_node *np;
+	unsigned long boot_addr, entry_el2;
+
+	if (exynos5433_smp_state != EXYNOS5433_SMP_NEW)
+		return exynos5433_smp_state == EXYNOS5433_SMP_READY ? 0 : -ENODEV;
+
+	np = of_find_compatible_node(NULL, NULL, "samsung,exynos5433-pmu");
+	if (np)
+		exynos5433_pmu = of_iomap(np, 0);
+	of_node_put(np);
+
+	np = of_find_compatible_node(NULL, NULL, "samsung,exynos4210-sysram-ns");
+	if (np)
+		exynos5433_sysram_ns = of_iomap(np, 0);
+	of_node_put(np);
+
+	if (!exynos5433_pmu || !exynos5433_sysram_ns) {
+		pr_err("EXYNOS5433: SMP: cannot map the PMU (samsung,exynos5433-pmu) or the monitor's boot window (samsung,exynos4210-sysram-ns); secondary CPUs stay off\n");
+		exynos5433_smp_state = EXYNOS5433_SMP_FAILED;
+		return -ENODEV;
+	}
+
+	pr_info("EXYNOS5433: SMP: boot CPU MPIDR 0x%03llx\n",
+		cpu_logical_map(0));
+	exynos5433_show_cpu_pmu("before SMP setup");
+
+	/*
+	 * The monitor takes 32-bit addresses: the AArch32 entry in its boot
+	 * register, the AArch64 entry in the SMC.  All of the board's memory is
+	 * below 4 GiB, so this cannot fail unless the kernel is loaded
+	 * elsewhere.
+	 */
+	boot_addr = __pa_symbol(exynos5433_smp_entry);
+	entry_el2 = __pa_symbol(exynos5433_smp_entry_el2);
+	if (boot_addr >> 32 || entry_el2 >> 32) {
+		pr_err("EXYNOS5433: SMP: the entry points are above 4 GiB (0x%lx, 0x%lx); secondary CPUs stay off\n",
+		       boot_addr, entry_el2);
+		exynos5433_smp_state = EXYNOS5433_SMP_FAILED;
+		return -ERANGE;
+	}
+
+	/* The entry point is in place before any core is powered, as the
+	 * vendor kernel puts it (platsmp.c:523-538).
+	 */
+	writel(boot_addr, exynos5433_sysram_ns + EXYNOS5433_BOOT_ADDR_OFFSET);
+
+	exynos5433_pmu_cpu_init();
+
+	exynos5433_smp_state = EXYNOS5433_SMP_READY;
+	pr_info("EXYNOS5433: SMP: entry 0x%08lx at sysram-ns + 0x%x, AArch64 entry 0x%08lx, PMU core options set\n",
+		boot_addr, EXYNOS5433_BOOT_ADDR_OFFSET, entry_el2);
+
+	return 0;
+}
+
+/*
+ * The 32-bit kernel's exynos5433_boot_secondary() (platsmp.c:605-712).
+ * Called with secondary_data already set for this CPU (__cpu_up()); the
+ * pen makes sure that no other CPU ever runs on with it.
+ */
+static int exynos5433_cpu_boot(unsigned int cpu)
+{
+	void __iomem *boot_reg = exynos5433_sysram_ns + EXYNOS5433_BOOT_ADDR_OFFSET;
+	u64 mpidr = cpu_logical_map(cpu);
+	unsigned int idx = exynos5433_pmu_core(mpidr);
+	unsigned long boot_addr = __pa_symbol(exynos5433_smp_entry);
+	unsigned int ms, i;
+	u32 status;
+	int ret;
+
+	mutex_lock(&exynos5433_boot_lock);
+
+	if (exynos5433_smp_state != EXYNOS5433_SMP_READY) {
+		if (exynos5433_smp_state == EXYNOS5433_SMP_FAILED)
+			pr_err("EXYNOS5433: CPU%u: not started: no secondary CPU is started after a failure\n",
+			       cpu);
+		ret = exynos5433_smp_state == EXYNOS5433_SMP_FAILED ?
+			-EIO : -ENODEV;
+		goto out;
+	}
+
+	/* entry point in place before the core is powered, as the vendor
+	 * kernel puts it (platsmp.c:637-640)
+	 */
+	writel(boot_addr, boot_reg);
+
+	WRITE_ONCE(exynos5433_arrived, false);
+	write_pen_release(mpidr);
+
+	status = exynos5433_pmu_read(EXYNOS_ARM_CORE_STATUS(idx));
+	if (exynos5433_core_powered(idx)) {
+		pr_warn("EXYNOS5433: CPU%u: core power already enabled (STATUS 0x%08x)\n",
+			cpu, status);
+	} else {
+		exynos5433_core_power_up(idx);
+
+		/* wait max 10 ms, 1 ms steps: the vendor kernel's limit, as the
+		 * 32-bit kernel keeps it (platsmp.c:655-659)
+		 */
+		ms = 0;
+		while (!exynos5433_core_powered(idx) && ms < 10) {
+			mdelay(1);
+			ms++;
+		}
+		if (!exynos5433_core_powered(idx)) {
+			pr_err("EXYNOS5433: CPU%u: core power-up timed out\n", cpu);
+			ret = -ETIMEDOUT;
+			goto fail;
+		}
+		pr_info("EXYNOS5433: CPU%u: MPIDR 0x%03llx, PMU core %u powered (STATUS 0x%08x -> 0x%08x, %u ms)\n",
+			cpu, mpidr, idx, status,
+			exynos5433_pmu_read(EXYNOS_ARM_CORE_STATUS(idx)), ms);
+	}
+
+	/*
+	 * The vendor kernel's release loop, as the 32-bit kernel keeps it
+	 * (platsmp.c:671-688): the entry point again and an event, until the
+	 * core is in the kernel.  No SMC (SMC_CMD_CPU1BOOT is not used on
+	 * this SoC) and no IPI: the vendor kernel sends neither.
+	 */
+	for (i = 0; i < EXYNOS5433_RELEASE_TRIES; i++) {
+		writel(boot_addr, boot_reg);
+		dsb(sy);
+		sev();
+
+		if (READ_ONCE(exynos5433_arrived))
+			break;
+
+		udelay(10);
+	}
+
+	if (!READ_ONCE(exynos5433_arrived)) {
+		pr_err("EXYNOS5433: CPU%u: did not reach the kernel within %u tries of 10 us\n",
+		       cpu, EXYNOS5433_RELEASE_TRIES);
+		ret = -ETIMEDOUT;
+		goto fail;
+	}
+
+	/*
+	 * The vendor kernel drops the HOTPLUG boot flag of a core once it is
+	 * up, and the 32-bit kernel does the same on every secondary start
+	 * (exynos_secondary_init(), platsmp.c:323-331): on this board the
+	 * firmware leaves it set on every core but the boot CPU.
+	 */
+	exynos5433_clear_boot_flag(idx, EXYNOS5433_BOOT_FLAG_HOTPLUG);
+
+	/* shut behind it: a core released from here on waits in the pen */
+	write_pen_release(INVALID_HWID);
+	mutex_unlock(&exynos5433_boot_lock);
+	return 0;
+
+fail:
+	/*
+	 * The pen stays shut, so that a core that shows up late waits there
+	 * instead of running on a secondary_data that is no longer its own,
+	 * and no other core is started: one released meanwhile could find it.
+	 */
+	write_pen_release(INVALID_HWID);
+	exynos5433_smp_state = EXYNOS5433_SMP_FAILED;
+	exynos5433_show_core("failed", idx);
+out:
+	mutex_unlock(&exynos5433_boot_lock);
+	return ret;
+}
+
+/* Called on the CPU that comes up, before it is online: the signal the
+ * release loop of exynos5433_cpu_boot() waits for.
+ */
+static void exynos5433_cpu_postboot(void)
+{
+	WRITE_ONCE(exynos5433_arrived, true);
+}
+
+/*
+ * No cpu_die: without it the kernel refuses to take a CPU offline
+ * (op_cpu_disable(), arch/arm64/kernel/smp.c), which is right here.  The
+ * monitor's shutdown call the 32-bit kernel makes from AArch32
+ * (exynos5433_cpu_die(), platsmp.c:822-875) has not been tried from
+ * AArch64.
+ */
+const struct cpu_operations exynos5433_smp_ops = {
+	.name		= "samsung,exynos5433-el2",
+	.cpu_init	= exynos5433_cpu_init,
+	.cpu_prepare	= exynos5433_cpu_prepare,
+	.cpu_boot	= exynos5433_cpu_boot,
+	.cpu_postboot	= exynos5433_cpu_postboot,
+};
diff --git a/arch/arm64/kernel/smp_exynos5433_head.S b/arch/arm64/kernel/smp_exynos5433_head.S
new file mode 100644
index 000000000..b87f6b49a
--- /dev/null
+++ b/arch/arm64/kernel/smp_exynos5433_head.S
@@ -0,0 +1,150 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Exynos 5433: the way of a secondary CPU from the secure monitor into the
+ * kernel.  The CPU side (PMU, boot register, pen) is in smp_exynos5433.c.
+ *
+ * The firmware offers no PSCI.  A core that the PMU powers on starts in
+ * AArch32 at the address found in the monitor's boot register (sysram-ns +
+ * 0x1c), which is how the vendor's 32-bit kernel starts its cores
+ * (arch/arm/mach-exynos/platsmp.c).  A 64-bit kernel has to take it from
+ * there:
+ *
+ *   exynos5433_smp_entry       AArch32.  SMC 0x82000400 makes the monitor
+ *                               switch the core to AArch64 at EL2, with the
+ *                               MMU and the caches off: the call a loader
+ *                               makes for the boot CPU.
+ *   exynos5433_smp_entry_el2   AArch64, EL2.  EL2 is put in the state the
+ *                               loader gives the boot CPU, then eret to EL1.
+ *   exynos5433_smp_pen         AArch64, EL1.  Wait until the pen holds this
+ *                               CPU's MPIDR, then join secondary_entry.
+ *
+ * All of it runs with the MMU and the caches off, at its physical address:
+ * no stack, no absolute address, nothing written.
+ *
+ * The three are defined with SYM_START(), not SYM_FUNC_START(): on arm64
+ * the latter puts a `bti c` first (asm/linkage.h), a NOP for AArch64 code
+ * but an instruction of the floating point unit for a core in AArch32.
+ * None of the three is reached through an indirect branch.
+ */
+
+#include <linux/const.h>
+#include <linux/init.h>
+#include <linux/linkage.h>
+
+#include <asm/assembler.h>
+#include <asm/cputype.h>
+#include <asm/kvm_arm.h>
+#include <asm/ptrace.h>
+#include <asm/sysreg.h>
+
+/*
+ * The monitor takes a 32-bit entry address, so both entries must be below
+ * 4 GiB: smp_exynos5433.c refuses to start a core otherwise.  The AArch64
+ * entry is on a 2 KiB boundary because that is where the entry proven for
+ * the boot CPU sits; whether the monitor cares is not known.
+ */
+	.balign 2048
+
+/*
+ * AArch32 code, in a file that the AArch64 assembler assembles: the words
+ * are those of the source in the comment.  Every register is unknown on
+ * arrival, and the core may still take interrupts: they are masked first.
+ * The distance to the AArch64 entry is a constant (2048), so that nothing
+ * here depends on where the kernel was loaded: this stub fills part of the
+ * 2 KiB the next one starts at.
+ */
+SYM_START(exynos5433_smp_entry, SYM_L_GLOBAL, SYM_A_NONE)
+	/*
+	 *	cpsid	aif
+	 *	ldr	r1, 3f			@ 2048 - 16
+	 *	add	r1, r1, pc		@ r1 = exynos5433_smp_entry_el2
+	 *	movw	r0, #0x400
+	 *	movt	r0, #0x8200		@ 0x82000400: enter AArch64 at EL2
+	 *	mov	r2, #0x800
+	 *	mov	r3, #1
+	 *	dsb	sy
+	 *	smc	#0
+	 *1:	wfe				@ the monitor came back: not switched
+	 *	b	1b			@ stay out of the way
+	 *	.balign 4
+	 *3:	.word	exynos5433_smp_entry_el2 - exynos5433_smp_entry - 16
+	 */
+.Lex32_words:
+	.word	0xf10c01c0		// cpsid	aif
+	.word	0xe59f1020		// ldr	r1, 3f
+	.word	0xe081100f		// add	r1, r1, pc
+	.word	0xe3000400		// movw	r0, #0x400
+	.word	0xe3480200		// movt	r0, #0x8200
+	.word	0xe3a02b02		// mov	r2, #0x800
+	.word	0xe3a03001		// mov	r3, #1
+	.word	0xf57ff04f		// dsb	sy
+	.word	0xe1600070		// smc	#0
+	.word	0xe320f002		// wfe
+	.word	0xeafffffd		// b	1b
+	.word	0x000007f0		// 2048 - 16
+.Lex32_words_end:
+SYM_FUNC_END(exynos5433_smp_entry)
+
+	/* With more than these 2 KiB used, the next entry would not be 2 KiB
+	 * after this one, and the constant above would be wrong. */
+	.if	.Lex32_words_end - .Lex32_words > 2048
+	.error	"exynos5433_smp_entry: longer than the 2 KiB the AArch32 stub assumes"
+	.endif
+
+	.balign 2048
+
+/*
+ * Where the monitor lands the core: AArch64 at EL2, MMU and caches off, as
+ * measured on the boot CPU (HCR_EL2 = 2, VBAR_EL2 = 0).  No vector table of
+ * the kernel is in place for this core: DAIF is masked before anything
+ * else.
+ *
+ * EL2 as the loader leaves it for the boot CPU (its boot_el1.S): RW, so
+ * that EL1 executes AArch64; EL1PCTEN and EL1PCEN and CNTVOFF, as the boot
+ * protocol asks of a CPU entered at EL1 (booting.rst, "Architected
+ * timers"); CPTR_EL2 and MDCR_EL2 clear, so that FP/SIMD (booting.rst,
+ * CPTR_EL2.TFP) and the debug registers do not trap.  Nothing more: the
+ * boot CPU of this kernel has exactly this EL2, and the cores must agree.
+ */
+SYM_START(exynos5433_smp_entry_el2, SYM_L_GLOBAL, SYM_A_NONE)
+	msr	daifset, #0xf
+	mov_q	x0, HCR_RW
+	msr	hcr_el2, x0
+	mrs	x0, cnthctl_el2
+	orr	x0, x0, #3
+	msr	cnthctl_el2, x0
+	msr	cntvoff_el2, xzr
+	msr	cptr_el2, xzr
+	msr	mdcr_el2, xzr
+	mov_q	x0, INIT_SCTLR_EL1_MMU_OFF
+	msr	sctlr_el1, x0
+	ic	iallu
+	dsb	sy
+	isb
+	adr_l	x0, exynos5433_smp_pen	// a physical address: the MMU is off
+	msr	elr_el2, x0
+	mov_q	x0, INIT_PSTATE_EL1	// EL1h, every exception masked
+	msr	spsr_el2, x0
+	eret
+SYM_FUNC_END(exynos5433_smp_entry_el2)
+
+/*
+ * The holding pen.  It is read from the memory itself (this core runs with
+ * its MMU off): the CPU that writes it cleans it there (write_pen_release()).
+ * The pen holds the MPIDR of the CPU being started, and only while its
+ * secondary_data is in place (__cpu_up()).  A core with another MPIDR that
+ * the monitor releases meanwhile, from the one boot register there is,
+ * waits here and goes on only when it is that CPU's turn.
+ */
+SYM_START(exynos5433_smp_pen, SYM_L_GLOBAL, SYM_A_NONE)
+	mrs	x1, mpidr_el1
+	mov_q	x2, MPIDR_HWID_BITMASK
+	and	x1, x1, x2
+	adr_l	x3, exynos5433_smp_pen_release
+1:	ldr	x4, [x3]
+	cmp	x4, x1
+	b.eq	2f
+	wfe
+	b	1b
+2:	b	secondary_entry
+SYM_FUNC_END(exynos5433_smp_pen)
