+# param_rescue: t715.paramrescue, for a tablet whose only system is started
+# by a loader in PARAM (bnuuyloader: it starts the arm64 kernel of a slot of
+# CACHE) and that keeps no other.  S-Boot boots this kernel (BOOT) when the
+# loader hands the boot back, because the arm64 system did not come up, and
+# at once when no loader runs at all: one that fails to fire is never
+# reached again, and nothing on the tablet could then be reached either.
+# So PARAM is looked at first.  $PARAMRESCUE_DIR holds a loader known to
+# work (param.img.gz, gzipped) with its sha256 (loader.sha256) and that of
+# the tablet's stock PARAM (stock.sha256), written by
+# boot/build-initramfs.sh --paramrescue, and the length of that part of
+# PARAM (extent; without the file, the whole image).  Only those first
+# bytes are compared and ever written: S-Boot keeps data of its own at the
+# end of PARAM and writes it whenever it boots a kernel itself (seen
+# 2026-11-25), so a loader followed by such data must still be the loader.
+# That part of PARAM holding either image is left alone, and so is one
+# holding any loader of also.sha256 (others that work, --paramrescue-also):
+# the one the owner put there is respected.  Holding anything else, it is a
+# loader that did not run: the known one is written over it and read back,
+# and the board restarts, which brings the arm64 system back by itself.  With the knob
+# off, a file of the directory missing, an image that is not the one its
+# sha256 announces, no single partition named PARAM, nothing more happens
+# here: the boot goes on to the root image, and so to the failure path and
+# its debug shell, as after a write that does not read back.  A loader
+# known here is one tablet's own PARAM: such an image is never published.
+# Host-test: the write is real (the test's loop disk) and exit 98 replaces
+# the restart.
+param_rescue() {
+    [ "$PARAMRESCUE" = 1 ] || return 0
+    if [ ! -s "$PARAMRESCUE_DIR/param.img.gz" ] || [ ! -s "$PARAMRESCUE_DIR/loader.sha256" ] ||
+        [ ! -s "$PARAMRESCUE_DIR/stock.sha256" ]; then
+        warn "t715.paramrescue: $PARAMRESCUE_DIR lacks a file, nothing done"
+        return 0
+    fi
+    _pr_known=$(cut -d' ' -f1 "$PARAMRESCUE_DIR/loader.sha256")
+    _pr_stock=$(cut -d' ' -f1 "$PARAMRESCUE_DIR/stock.sha256")
+    if [ "$(zcat "$PARAMRESCUE_DIR/param.img.gz" | sha256sum | cut -d' ' -f1)" != "$_pr_known" ]; then
+        warn "t715.paramrescue: param.img.gz is not the image loader.sha256 announces, nothing done"
+        return 0
+    fi
+    _pr_hits=$(list_partnames | while read -r _pr_d _pr_n; do
+        if [ "$_pr_n" = PARAM ]; then printf '%s ' "$_pr_d"; fi
+    done)
+    set -f
+    # shellcheck disable=SC2086  # count the words
+    set -- $_pr_hits
+    set +f
+    if [ "$#" -ne 1 ] || [ ! -b "/dev/$1" ]; then
+        warn "t715.paramrescue: no single partition named PARAM (${_pr_hits:-none}), nothing done"
+        return 0
+    fi
+    _pr_dev=/dev/$1
+    _pr_size=$(cat "$PARAMRESCUE_DIR/extent" 2>/dev/null)
+    [ -n "$_pr_size" ] || _pr_size=$(zcat "$PARAMRESCUE_DIR/param.img.gz" | wc -c)
